<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>opencode-docker</ToolCommandName>
    <PackageId>opencode-docker-cli</PackageId>
    <Version>1.0.0</Version>
    <Description>Windows CLI wrapper for running OpenCode in Docker (sister of claude-docker-cli)</Description>
    <AssemblyName>opencode-docker-cli</AssemblyName>
    <ApplicationIcon>..\claude-docker-cli\claude.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\claude-docker-cli\Program.cs" Link="Program.cs" />
    <None Include="..\claude-docker-cli\claude.ico" Link="claude.ico" />
  </ItemGroup>
</Project>
