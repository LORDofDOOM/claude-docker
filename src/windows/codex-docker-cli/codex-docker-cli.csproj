<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codex-docker</ToolCommandName>
    <PackageId>codex-docker-cli</PackageId>
    <Version>1.0.0</Version>
    <Description>Windows CLI wrapper for running Codex CLI in Docker (sister of claude-docker-cli)</Description>
    <AssemblyName>codex-docker-cli</AssemblyName>
    <ApplicationIcon>..\..\..\codex.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\claude-docker-cli\Program.cs" Link="Program.cs" />
    <None Include="..\..\..\codex.ico" Link="codex.ico" />
  </ItemGroup>
</Project>
